@model AuditLogPage
@{
    ViewData["Title"] = "Audit log";
}

<h1 class="h3 mb-3">Audit log</h1>

<form asp-action="AuditLog" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="actionFilter" value="@ViewData["ActionFilter"]" class="form-control" placeholder="Action" />
    </div>
    <div class="col-auto">
        <input name="userName" value="@ViewData["UserName"]" class="form-control" placeholder="User" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="AuditLog" class="btn btn-link">Clear</a>
    </div>
</form>

<p class="text-body-secondary">@Model.TotalCount entries — page @Model.Page of @Math.Max(1, Model.TotalPages)</p>

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>IP</th><th>OK</th><th>Details</th></tr>
        </thead>
        <tbody>
        @foreach (var entry in Model.Items)
        {
            <tr>
                <td class="text-nowrap">@entry.OccurredUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@entry.UserName</td>
                <td><code>@entry.Action</code></td>
                <td class="small text-body-secondary">@entry.EntityType @entry.EntityId</td>
                <td class="small text-body-secondary">@entry.IpAddress</td>
                <td>
                    @if (entry.Succeeded)
                    {
                        <span class="badge text-bg-success">yes</span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger">no</span>
                    }
                </td>
                <td class="small text-body-secondary text-break">@entry.DetailsJson</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<nav>
    <ul class="pagination">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" asp-action="AuditLog"
               asp-route-page="@(Model.Page - 1)"
               asp-route-actionFilter="@ViewData["ActionFilter"]"
               asp-route-userName="@ViewData["UserName"]">Previous</a>
        </li>
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link" asp-action="AuditLog"
               asp-route-page="@(Model.Page + 1)"
               asp-route-actionFilter="@ViewData["ActionFilter"]"
               asp-route-userName="@ViewData["UserName"]">Next</a>
        </li>
    </ul>
</nav>
