@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-4">Sign in</h1>

        @if (TempData["ExternalError"] is string externalError)
        {
            <div class="alert alert-danger">@externalError</div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-when-empty"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Sign in</button>
            <a asp-action="Register" class="btn btn-link">Create an account</a>
        </form>

        @if (ViewData["ExternalProviders"] is IReadOnlyList<ExternalProvider> providers && providers.Count > 0)
        {
            <hr class="my-4" />
            <p class="text-body-secondary small">Or sign in with</p>

            <form asp-action="ExternalLogin" method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                @foreach (var provider in providers)
                {
                    <button type="submit" name="provider" value="@provider.Name"
                            class="btn btn-outline-secondary me-2">@provider.DisplayName</button>
                }
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
