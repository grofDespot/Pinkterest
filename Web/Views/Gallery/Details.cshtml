@model PhotoDetail
@{
    ViewData["Title"] = "Photo";
    var presets = ViewData["Presets"] as IReadOnlyList<FilterPresetDto> ?? [];
    var canEdit = User.Identity?.IsAuthenticated == true &&
                  (User.IsInRole(Roles.Administrator) ||
                   User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.OwnerId.ToString());
}

<div class="row g-4">
    <div class="col-lg-8">
        <img src="@Url.Action("Raw", new { id = Model.Id })" class="img-fluid rounded" alt="@Model.Description" />
    </div>
    <div class="col-lg-4">
        <h1 class="h4">@Model.AuthorDisplayName</h1>
        <p class="text-body-secondary">@Model.UploadedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>

        <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "(no description)" : Model.Description)</p>

        <div class="mb-3">
            @foreach (var hashtag in Model.Hashtags)
            {
                <a asp-action="Search" asp-route-Hashtag="@hashtag" class="badge text-bg-light text-decoration-none">#@hashtag</a>
            }
        </div>

        <dl class="row small">
            <dt class="col-5">Dimensions</dt>
            <dd class="col-7">@Model.Width × @Model.Height</dd>

            <dt class="col-5">Size</dt>
            <dd class="col-7">@ByteSize.Humanize(Model.SizeBytes)</dd>

            <dt class="col-5">Type</dt>
            <dd class="col-7">@Model.ContentType</dd>

            <dt class="col-5">File name</dt>
            <dd class="col-7 text-break">@Model.OriginalFileName</dd>
        </dl>

        <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary w-100 mb-3">
            Download original
        </a>

        @if (TempData["PresetSaved"] is string savedPreset)
        {
            <div class="alert alert-success py-2 small">Saved preset &ldquo;@savedPreset&rdquo;.</div>
        }
        @if (TempData["PresetError"] is string presetError)
        {
            <div class="alert alert-danger py-2 small">@presetError</div>
        }

        @if (presets.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h6">Download with a saved preset</h2>
                    <form asp-action="Download" method="get" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="presetId" class="form-select form-select-sm">
                            @foreach (var preset in presets)
                            {
                                <option value="@preset.Id">@preset.Name — @preset.Summary</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary text-nowrap">Download</button>
                    </form>
                    <a asp-controller="Photos" asp-action="Presets" class="small">Manage presets</a>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-body">
                <h2 class="h6">Download with filters</h2>

                <form asp-action="Download" method="get">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-2">
                        <label for="Format" class="form-label small">Format</label>
                        <select name="Format" id="Format" class="form-select form-select-sm"
                                asp-items="Html.GetEnumSelectList<ImageOutputFormat>()"></select>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label for="MaxWidth" class="form-label small">Max width</label>
                            <input type="number" name="MaxWidth" id="MaxWidth" class="form-control form-control-sm" min="0" />
                        </div>
                        <div class="col-6">
                            <label for="MaxHeight" class="form-label small">Max height</label>
                            <input type="number" name="MaxHeight" id="MaxHeight" class="form-control form-control-sm" min="0" />
                        </div>
                    </div>

                    <div class="mb-3">
                        @foreach (var filter in ImageFilterCatalog.AvailableFilters)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="Filters"
                                       value="@filter" id="dl-@filter" />
                                <label class="form-check-label text-capitalize small" for="dl-@filter">@filter</label>
                            </div>
                        }
                    </div>

                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">Download</button>
                </form>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <hr class="my-3" />
                    <form asp-controller="Photos" asp-action="SavePreset" method="post">
                        <input type="hidden" name="PhotoId" value="@Model.Id" />
                        <input type="hidden" name="Format" id="preset-format" />
                        <input type="hidden" name="MaxWidth" id="preset-width" />
                        <input type="hidden" name="MaxHeight" id="preset-height" />
                        <div id="preset-filters"></div>

                        <label for="preset-name" class="form-label small">Save these settings as</label>
                        <div class="d-flex gap-2">
                            <input name="Name" id="preset-name" class="form-control form-control-sm"
                                   placeholder="web thumbnail" maxlength="64" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">Save</button>
                        </div>
                    </form>
                }
            </div>
        </div>

        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary mt-3">Edit details</a>
        }
        <a asp-action="Index" class="btn btn-link mt-3">Back to gallery</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/preset-form.js" asp-append-version="true"></script>
}
