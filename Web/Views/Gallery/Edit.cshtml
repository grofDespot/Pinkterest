@model EditPhotoViewModel
@{
    ViewData["Title"] = "Edit photo";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="h3 mb-4">Edit photo details</h1>

        <img src="@Url.Action("Thumbnail", new { id = Model.Id })" class="img-fluid rounded mb-4" alt="" />

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-when-empty"></div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Hashtags" class="form-label"></label>
                <input asp-for="Hashtags" class="form-control" />
                <div class="form-text">Separate with spaces or commas.</div>
                <span asp-validation-for="Hashtags" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
